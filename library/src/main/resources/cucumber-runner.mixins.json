{
  "required": true,
  "package": "net.cucumberfabric.mixin",
  "compatibilityLevel": "JAVA_21",
  "mixins": [
    "LevelStorageSourceMixin",
    "GameProfileCacheMixin",
    "StoredUserListMixin"
  ],
  "server": [
    "server.DedicatedServerSettingsMixin",
    "server.EulaMixin",
    "server.ServerLevelMixin"
  ],
  "client": [
    "client.MinecraftMixin"
  ],
  "injectors": {
    "defaultRequire": 1,
    "maxShiftBy": 2
  }
}